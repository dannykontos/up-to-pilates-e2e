# Copy this file to .env to override defaults for local runs.
# Never commit a real .env file - it is gitignored.

# Base URL of the site under test. Defaults to production if not set.
BASE_URL=https://uptopilates.ro/

# Set to "true" to enable the contact form submission test.
# Disabled by default so the suite never sends real messages/emails to
# the production mailbox. Point BASE_URL at a staging site (if one exists)
# before enabling this.
ENABLE_CONTACT_SUBMISSION=false

# Optional: contact test data used only when ENABLE_CONTACT_SUBMISSION=true.
TEST_CONTACT_FIRST_NAME=QA
TEST_CONTACT_LAST_NAME=Automation
TEST_CONTACT_EMAIL=qa-automation@example.com
